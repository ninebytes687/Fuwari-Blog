---
import { Icon } from "astro-icon/components";

interface Props {
    class?: string;
    style?: string;
}
const className = Astro.props.class ?? "";
const style = Astro.props.style ?? "";

// ✅ 只有 JS API Key（它可以公开，因为有域名白名单），Web 服务 Key 彻底移除！
const AMAP_JS_KEY = "014ac6ebea911e72368ab86c6f46307c";
---

<div
    class={"card-base w-full px-4 py-3 flex items-center gap-3 " + className}
    style={style}
    id="weather-card-root"
>
    <div id="weather-icon-wrap" class="flex-shrink-0 w-12 h-12 flex items-center justify-center text-4xl text-[var(--primary)]">
        <Icon name="fa6-solid:cloud-sun" />
    </div>
    <div class="flex-1 min-w-0">
        <div id="weather-city" class="font-bold text-sm truncate text-neutral-900 dark:text-neutral-100">
            定位中...
        </div>
        <div id="weather-temp" class="text-xs mt-0.5 text-neutral-600 dark:text-neutral-400">
            正在获取天气...
        </div>
    </div>
</div>

<script>
    // ========== 缓存配置 ==========
    var WEATHER_CACHE_TTL = 6 * 3600 * 1000;
    var LOCATION_CACHE_TTL = 7 * 24 * 3600 * 1000;
    var MIN_INTERVAL = 15 * 1000;
    var TIMEOUT = 10 * 1000;
    var LS_LOC = "__fw_loc__";
    var LS_WEATHER = "__fw_weather__";
    var LS_LAST = "__fw_last__";

    // ========== 兜底城市：保定市 ==========
    var FALLBACK_NAME = "河北 保定";
    var FALLBACK_ADCODE = "130600";
    var FALLBACK_SHORT = "保定";

    // ========== 关键字 adcode 映射 ==========
    var KW_ADCODE_MAP = {
        "保定": "130600", "保定市": "130600", "河北": "130000", "河北省": "130000",
        "石家庄": "130100", "唐山市": "130200", "秦皇岛": "130300", "邯郸": "130400",
        "邢台": "130500", "张家口": "130700", "承德": "130800", "沧州": "130900",
        "廊坊": "131000", "衡水": "131100",
        "北京": "110000", "北京市": "110000", "天津": "120000", "上海": "310000", "重庆": "500000",
        "广州": "440100", "深圳": "440300", "杭州": "330100", "南京": "320100", "成都": "510100",
        "武汉": "420100", "西安": "610100", "郑州": "410100", "济南": "370100", "青岛": "370200",
        "长沙": "430100", "沈阳": "210100", "哈尔滨": "230100", "长春": "220100",
        "福州": "350100", "厦门": "350200", "昆明": "530100", "南宁": "450100", "贵阳": "520100",
        "兰州": "620100", "乌鲁木齐": "650100", "呼和浩特": "150100", "银川": "640100",
        "西宁": "630100", "海口": "460100", "太原": "140100", "合肥": "340100",
        "南昌": "360100", "拉萨": "540100", "香港": "810000", "澳门": "820000", "台北": "710100",
    };
    function guessAdcode(regionName, cityName) {
        var text = (regionName || "") + " " + (cityName || "");
        var keys = Object.keys(KW_ADCODE_MAP);
        for (var i = 0; i < keys.length; i++) if (text.indexOf(keys[i]) >= 0) return KW_ADCODE_MAP[keys[i]];
        return "";
    }

    var ICON_MAP = {
        "晴": "fa6-solid:sun", "少云": "fa6-solid:cloud-sun", "晴间多云": "fa6-solid:cloud-sun",
        "多云": "fa6-solid:cloud", "阴": "fa6-solid:cloud", "雾": "fa6-solid:smog", "霾": "fa6-solid:smog",
        "浮尘": "fa6-solid:smog", "扬沙": "fa6-solid:smog", "小雨": "fa6-solid:cloud-rain",
        "中雨": "fa6-solid:cloud-rain", "大雨": "fa6-solid:cloud-showers-heavy",
        "暴雨": "fa6-solid:cloud-showers-heavy", "雷阵雨": "fa6-solid:cloud-bolt-rain",
        "雨夹雪": "fa6-solid:cloud-sleet", "小雪": "fa6-solid:snowflake", "中雪": "fa6-solid:snowflake",
        "大雪": "fa6-solid:snowflake", "暴雪": "fa6-solid:snowflake", "冻雨": "fa6-solid:icicles",
    };
    var EMOJI_MAP = {
        "晴":"☀️","少云":"🌤️","晴间多云":"⛅","多云":"☁️","阴":"☁️","雾":"🌫️","霾":"🌫️",
        "小雨":"🌧️","中雨":"🌧️","大雨":"🌧️","暴雨":"🌧️","雷阵雨":"⛈️","雨夹雪":"🌨️","小雪":"❄️",
        "中雪":"❄️","大雪":"❄️","暴雪":"❄️","冻雨":"🧊",
    };
    function renderIcon(type, el) {
        var name = ICON_MAP[type] || "fa6-solid:cloud-sun";
        return fetch("https://api.iconify.design/" + name.replace(":", "/") + ".svg")
            .then(function(r) { return r.ok ? r.text() : Promise.reject(); })
            .then(function(svg) { el.innerHTML = svg.replace("<svg ", "<svg class=\"w-10 h-10 text-[var(--primary)]\" "); })
            .catch(function() { el.innerHTML = "<span class=\"text-4xl leading-none\">" + (EMOJI_MAP[type] || "🌤️") + "</span>"; });
    }

    function showError(cityEl, tempEl, iconWrap, msg) {
        cityEl.textContent = "天气加载失败";
        tempEl.textContent = msg;
        tempEl.classList.add("text-red-500", "dark:text-red-400");
        iconWrap.innerHTML = "<span class=\"text-3xl leading-none text-neutral-400 dark:text-neutral-500\">😵</span>";
    }
    function getCache(key, ttl) {
        try { var raw = localStorage.getItem(key); if (!raw) return null; var o = JSON.parse(raw); if (Date.now() - o._t > ttl) return null; return o; }
        catch (e) { return null; }
    }
    function setCache(key, data) {
        try { data._t = Date.now(); localStorage.setItem(key, JSON.stringify(data)); } catch (e) {}
    }
    function isNum(v) { return v !== undefined && v !== null && v !== "" && !isNaN(Number(String(v))); }
    function nonEmpty(v) {
        if (v === undefined || v === null) return "";
        if (Array.isArray(v)) return "";
        var s = String(v).trim();
        if (s === "" || s === "[]" || s === "{}" || s === "null" || s === "undefined") return "";
        return s;
    }
    function trimCity(s) { return nonEmpty(s).replace(/(省|市|地区|自治州|自治区|特别行政区)$/g, ""); }

    // ========== 定位：免费公共 ip-api.com（JSONP，无需 Key，不限量，保定准确率高） ==========
    function doLocate() {
        return new Promise(function(resolve, reject) {
            var cbName = "__jp_" + Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
            var script = document.createElement("script");
            var timer = setTimeout(function() { reject(new Error("定位超时")); cleanup(); }, TIMEOUT);
            function cleanup() {
                clearTimeout(timer);
                try { delete window[cbName]; } catch (e) { window[cbName] = undefined; }
                if (script.parentNode) script.parentNode.removeChild(script);
            }
            window[cbName] = function(d) {
                cleanup();
                if (!d || d.status !== "success") { reject(new Error("定位返回失败")); return; }
                var country = nonEmpty(d.countryCode || d.country);
                if (country !== "CN" && country !== "China") { reject(new Error("非中国IP，默认保定")); return; }
                var region = trimCity(nonEmpty(d.regionName || ""));
                var cty = trimCity(nonEmpty(d.city || ""));
                var adc = guessAdcode(region, cty);
                // 国内 IP 准确率挺高，就算拿不到 adcode，兜底保定也能显示天气
                if (!adc) adc = FALLBACK_ADCODE;
                resolve({ province: region, city: cty || region || FALLBACK_SHORT, adcode: adc });
            };
            script.onerror = function() { reject(new Error("定位脚本加载失败")); cleanup(); };
            script.src = "http://ip-api.com/json/?lang=zh-CN&callback=" + cbName;
            document.head.appendChild(script);
        });
    }

    // ========== 主入口 ==========
    (function init() {
        var root = document.getElementById("weather-card-root");
        var iconWrap = document.getElementById("weather-icon-wrap");
        var cityEl = document.getElementById("weather-city");
        var tempEl = document.getElementById("weather-temp");
        if (!root || !iconWrap || !cityEl || !tempEl) return;
        if (window.__weatherLoaded) return;
        window.__weatherLoaded = true;
        tempEl.classList.remove("text-red-500", "dark:text-red-400");

        var lastRun = parseInt(localStorage.getItem(LS_LAST) || "0", 10);
        var throttled = (Date.now() - lastRun) < MIN_INTERVAL;
        localStorage.setItem(LS_LAST, String(Date.now()));

        Promise.resolve().then(async function() {
            // ---------- 1. 定位 ----------
            var cityName = FALLBACK_NAME;
            var adcode = FALLBACK_ADCODE;
            var cityShort = FALLBACK_SHORT;
            var locC = getCache(LS_LOC, LOCATION_CACHE_TTL);
            if (locC && locC.cityName && nonEmpty(locC.adcode)) {
                cityName = locC.cityName;
                adcode = String(locC.adcode);
                cityShort = locC.short || trimCity(cityName.split(/\s+/).filter(Boolean).pop() || FALLBACK_SHORT);
            } else if (!throttled) {
                try {
                    var r = await doLocate();
                    var p = r.province || "";
                    var c = r.city || "";
                    if (c) {
                        cityName = p && p !== c ? p + " " + c : c;
                        adcode = nonEmpty(r.adcode) || FALLBACK_ADCODE;
                        cityShort = c || FALLBACK_SHORT;
                        setCache(LS_LOC, { cityName: cityName, adcode: adcode, short: cityShort });
                    }
                } catch (eLoc) {
                    // 定位失败，兜底保定
                    setCache(LS_LOC, { cityName: FALLBACK_NAME, adcode: FALLBACK_ADCODE, short: FALLBACK_SHORT });
                }
            }
            cityEl.textContent = cityName;

            // ---------- 2. 天气：调自己的 /api/weather 代理（Web 服务 Key 只存服务端，不泄露！） ----------
            var maxTemp = "--";
            var minTemp = "--";
            var weatherType = "晴";
            var isLive = false;
            var wC = getCache(LS_WEATHER, WEATHER_CACHE_TTL);
            var cacheOK = wC && wC.adcode === adcode && isNum(wC.maxTemp) && isNum(wC.minTemp);
            if (cacheOK) {
                maxTemp = wC.maxTemp; minTemp = wC.minTemp; weatherType = wC.weatherType || "晴"; isLive = !!wC.isLive;
            } else if (!throttled) {
                try {
                    var ref = (location && location.hostname) ? encodeURIComponent(location.hostname) : "";
                    var ua = encodeURIComponent((navigator && navigator.userAgent) ? navigator.userAgent.slice(0, 100) : "");
                    var apiUrl = "/api/weather?city=" + encodeURIComponent(adcode) + "&ref=" + ref + "&ua=" + ua;
                    var ctrl = new AbortController();
                    var t = setTimeout(function() { ctrl.abort(); }, TIMEOUT);
                    var resp = await fetch(apiUrl, { method: "GET", signal: ctrl.signal });
                    clearTimeout(t);
                    if (!resp.ok) throw new Error("HTTP_" + resp.status);
                    var data = await resp.json();
                    if (!data || !data.ok) throw new Error(data.error || data.msg || "返回异常");
                    maxTemp = String(data.maxTemp);
                    minTemp = String(data.minTemp);
                    weatherType = String(data.weather || "晴");
                    isLive = !!data.isLive;
                    setCache(LS_WEATHER, { adcode: adcode, maxTemp: maxTemp, minTemp: minTemp, weatherType: weatherType, isLive: isLive });
                } catch (eW) {
                    showError(cityEl, tempEl, iconWrap, "天气获取失败（刷新重试）");
                    return;
                }
            } else if (throttled && !cacheOK) {
                tempEl.textContent = "冷却中，稍后刷新…";
                return;
            }
            tempEl.textContent = (isLive ? "当前 " : "") + "最高 " + maxTemp + "° / 最低 " + minTemp + "°";
            await renderIcon(weatherType, iconWrap);
        }).catch(function() {
            showError(cityEl, tempEl, iconWrap, "内部错误，请刷新重试");
        });
    })();
</script>