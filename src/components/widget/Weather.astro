---
import { Icon } from "astro-icon/components";
// 从 Vercel 环境变量读取 API Key
const AMAP_KEY = import.meta.env.PUBLIC_AMAP_KEY;
---

<div class="weather-card card-base p-4 onload-animation" style="animation-delay: 250ms">
    <div id="weather-content" class="flex items-center gap-3">
        <div id="weather-icon" class="weather-icon flex-shrink-0 w-12 h-12 flex items-center justify-center">
            <Icon name="material-symbols:cloud" class="text-3xl text-[var(--primary)]"></Icon>
        </div>
        <div class="weather-info flex-grow min-w-0">
            <div id="city-name" class="font-medium text-neutral-900 dark:text-neutral-100 truncate">加载中...</div>
            <div id="temperature" class="text-sm text-neutral-500 dark:text-neutral-400">--°C / --°C</div>
        </div>
    </div>
    <div id="weather-error" class="hidden text-sm text-neutral-500 dark:text-neutral-400 text-center py-2">
        无法获取天气信息
    </div>
</div>

<style>
    .weather-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .weather-card:hover {
        transform: translateY(-2px);
    }

    .weather-icon {
        background: linear-gradient(135deg, oklch(0.95 0.02 var(--hue)), oklch(0.9 0.03 var(--hue)));
        border-radius: 0.75rem;
        transition: all 0.3s ease;
    }

    :global(.dark) .weather-icon {
        background: linear-gradient(135deg, oklch(0.25 0.02 var(--hue)), oklch(0.3 0.03 var(--hue)));
    }
</style>

<script define:vars={{ AMAP_KEY }}>
    // ⚙️ 城市配置
    const TARGET_CITY = '保定';
    const TARGET_ADCODE = '130600';

    const amapWeatherMap = {
        '晴': { icon: 'material-symbols:sunny', description: '晴天' },
        '多云': { icon: 'material-symbols:partly-cloudy-day', description: '多云' },
        '阴': { icon: 'material-symbols:cloud', description: '阴天' },
        '阵雨': { icon: 'material-symbols:rainy-light', description: '阵雨' },
        '雷阵雨': { icon: 'material-symbols:thunderstorm', description: '雷阵雨' },
        '雷阵雨伴有冰雹': { icon: 'material-symbols:thunderstorm', description: '雷暴伴冰雹' },
        '雨夹雪': { icon: 'material-symbols:ac-unit', description: '雨夹雪' },
        '小雨': { icon: 'material-symbols:rainy-light', description: '小雨' },
        '中雨': { icon: 'material-symbols:rainy', description: '中雨' },
        '大雨': { icon: 'material-symbols:rainy-heavy', description: '大雨' },
        '暴雨': { icon: 'material-symbols:rainy-heavy', description: '暴雨' },
        '大暴雨': { icon: 'material-symbols:rainy-heavy', description: '大暴雨' },
        '特大暴雨': { icon: 'material-symbols:rainy-heavy', description: '特大暴雨' },
        '小雪': { icon: 'material-symbols:ac-unit', description: '小雪' },
        '中雪': { icon: 'material-symbols:ac-unit', description: '中雪' },
        '大雪': { icon: 'material-symbols:ac-unit', description: '大雪' },
        '暴雪': { icon: 'material-symbols:ac-unit', description: '暴雪' },
        '雾': { icon: 'material-symbols:foggy', description: '雾' },
        '冻雨': { icon: 'material-symbols:ac-unit', description: '冻雨' },
        '沙尘暴': { icon: 'material-symbols:air', description: '沙尘暴' },
        '浮尘': { icon: 'material-symbols:air', description: '浮尘' },
        '扬沙': { icon: 'material-symbols:air', description: '扬沙' },
        '强沙尘暴': { icon: 'material-symbols:air', description: '强沙尘暴' },
        '霾': { icon: 'material-symbols:foggy', description: '霾' },
    };

    async function getWeatherData() {
        const weatherContent = document.getElementById('weather-content');
        const weatherError = document.getElementById('weather-error');
        const cityNameEl = document.getElementById('city-name');
        const temperatureEl = document.getElementById('temperature');
        const weatherIconEl = document.querySelector('#weather-icon icon');

        console.log(`🚀 开始获取 ${TARGET_CITY} 的天气...`);

        if (!AMAP_KEY) {
            console.error('❌ 未配置 PUBLIC_AMAP_KEY 环境变量');
            if (weatherContent) weatherContent.classList.add('hidden');
            if (weatherError) {
                weatherError.classList.remove('hidden');
                weatherError.textContent = '请配置天气 API Key';
            }
            return;
        }

        try {
            // 调用高德天气 API
            console.log('📡 请求高德天气 API...');
            const response = await fetch(
                `https://restapi.amap.com/v3/weather/weatherInfo?key=${AMAP_KEY}&city=${TARGET_ADCODE}&extensions=all&output=JSON`
            );
            
            const data = await response.json();
            console.log('📊 天气数据:', data);

            if (data.status !== '1' || !data.forecasts?.[0]) {
                throw new Error(data.info || '天气查询失败');
            }

            const todayCast = data.forecasts[0].casts[0];
            if (!todayCast) throw new Error('无今日天气预报');

            const dayWeather = todayCast.dayweather;
            const maxTemp = parseInt(todayCast.daytemp);
            const minTemp = parseInt(todayCast.nighttemp);
            
            console.log(`☀️ ${TARGET_CITY} 今日${dayWeather}: ${maxTemp}°C / ${minTemp}°C`);
            
            const weatherInfo = amapWeatherMap[dayWeather] || { 
                icon: 'material-symbols:cloud', 
                description: dayWeather 
            };

            if (cityNameEl) cityNameEl.textContent = `${TARGET_CITY} · ${weatherInfo.description}`;
            if (temperatureEl) temperatureEl.textContent = `${maxTemp}°C / ${minTemp}°C`;
            if (weatherIconEl) weatherIconEl.setAttribute('name', weatherInfo.icon);
            
            console.log('✅✅✅ 天气加载完成！');
            
        } catch (error) {
            console.error('❌ 获取失败:', error);
            if (weatherContent) weatherContent.classList.add('hidden');
            if (weatherError) weatherError.classList.remove('hidden');
        }
    }

    // 页面加载后执行
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(getWeatherData, 300);
    });
</script>